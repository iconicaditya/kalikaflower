{
  "compilerOptions": {
    "outDir": "./dist/",
    "paths": {
      "@/*": ["./src/*"],
      "modelence/client": ["./src/client/shims/modelence-client.ts"],
      "@modelence/react-query": ["./src/client/shims/modelence-react-query.ts"]
    },
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [],
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
